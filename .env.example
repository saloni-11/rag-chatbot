# .env.example — copy to .env and fill in. Never commit .env.
#   cp .env.example .env
# Only variables the code actually reads are listed. Values shown are the defaults.

# ── Required ───────────────────────────────────────
# Groq API key (https://console.groq.com/keys). Used by the app and the RAGAS judge.
GROQ_API_KEY=your-groq-api-key-here

# ── Hugging Face model loading ─────────────────────
# 1 = load the embedding model and reranker from the local cache only.
# Set 0 for the first run so the models can be downloaded.
HF_HUB_OFFLINE=0

# ── Guardrails (true cosine similarity, -1..1) ─────
SCOPE_THRESHOLD=0.2
CONFIDENCE_MIN_COSINE=0.307
SOURCE_MIN_COSINE=0.25

# ── Retrieval ──────────────────────────────────────
# hybrid = dense + BM25 + cross-encoder rerank; dense = the original ChromaDB top-3
RETRIEVAL_MODE=hybrid
# Candidates each retriever contributes before fusion
HYBRID_CANDIDATES=15
# Reciprocal Rank Fusion constant
RRF_K=60
# Fused candidates sent to the reranker (0 = all)
RERANK_POOL=10

# ── Evaluation only ────────────────────────────────
# LLM judge for RAGAS (src/evaluation/ragas_eval.py)
EVAL_JUDGE_MODEL=openai/gpt-oss-120b
